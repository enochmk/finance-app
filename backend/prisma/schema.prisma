generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
  LOAN
}

enum CategoryType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model Currency {
  id        String   @id @default(uuid())
  name      String
  shortcode String   @unique
  symbol    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  name                  String
  currency              String                 @default("GHS")
  accounts              Account[]
  categories            Category[]
  budgets               Budget[]
  transactions          Transaction[]          @relation("UserTransactions")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Account {
  id                            String                 @id @default(uuid())
  userId                        String
  name                          String
  type                          AccountType
  currency                      String                 @default("GHS")
  color                         String?                @default("#176b6c")
  icon                          String?
  openingBalance                Decimal                @default(0) @db.Decimal(14, 2)
  currentBalance                Decimal                @default(0) @db.Decimal(14, 2)
  institutionName               String?
  accountNumberMasked           String?
  isArchived                    Boolean                @default(false)
  position                      Int                    @default(0)
  user                          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions                  Transaction[]          @relation("PrimaryAccountTransactions")
  transferTransactions          Transaction[]          @relation("TransferDestinationAccount")
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id                    String                 @id @default(uuid())
  userId                String
  name                  String
  type                  CategoryType
  color                 String?
  icon                  String?
  isSystem              Boolean                @default(false)
  isArchived            Boolean                @default(false)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subCategories         SubCategory[]
  budgets               Budget[]
  transactions          Transaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([userId, type])
}

model SubCategory {
  id                    String                 @id @default(uuid())
  categoryId            String
  name                  String
  icon                  String?
  isSystem              Boolean                @default(false)
  isArchived            Boolean                @default(false)
  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([categoryId])
}

model Transaction {
  id                String          @id @default(uuid())
  userId            String
  accountId         String
  categoryId        String?
  subCategoryId     String?
  type              TransactionType
  amount            Decimal         @db.Decimal(14, 2)
  description       String
  notes             String?
  transactionDate   DateTime
  transferAccountId String?
  externalReference String?
  user              User            @relation("UserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  account           Account         @relation("PrimaryAccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategory       SubCategory?    @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  transferAccount   Account?        @relation("TransferDestinationAccount", fields: [transferAccountId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId, transactionDate])
  @@index([accountId, transactionDate])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([transferAccountId])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  amount     Decimal  @db.Decimal(14, 2)
  month      Int
  year       Int
  notes      String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
}
