generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
  LOAN
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringTransactionStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  name                  String
  currency              String                 @default("GHS")
  accounts              Account[]
  categories            Category[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  transactions          Transaction[]          @relation("UserTransactions")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Account {
  id                            String                 @id @default(uuid())
  userId                        String
  name                          String
  type                          AccountType
  currency                      String                 @default("GHS")
  color                         String?                @default("#176b6c")
  icon                          String?
  openingBalance                Decimal                @default(0) @db.Decimal(14, 2)
  currentBalance                Decimal                @default(0) @db.Decimal(14, 2)
  institutionName               String?
  accountNumberMasked           String?
  isArchived                    Boolean                @default(false)
  user                          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringTransactions         RecurringTransaction[] @relation("RecurringPrimaryAccount")
  recurringTransferTransactions RecurringTransaction[] @relation("RecurringTransferAccount")
  transactions                  Transaction[]          @relation("PrimaryAccountTransactions")
  transferTransactions          Transaction[]          @relation("TransferDestinationAccount")
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Category {
  id                    String                 @id @default(uuid())
  userId                String
  name                  String
  type                  CategoryType
  color                 String?
  icon                  String?
  isSystem              Boolean                @default(false)
  isArchived            Boolean                @default(false)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  transactions          Transaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([userId, type, name])
  @@index([userId, type])
}

model Transaction {
  id                String          @id @default(uuid())
  userId            String
  accountId         String
  categoryId        String?
  type              TransactionType
  amount            Decimal         @db.Decimal(14, 2)
  description       String
  notes             String?
  transactionDate   DateTime
  transferAccountId String?
  externalReference String?
  user              User            @relation("UserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  account           Account         @relation("PrimaryAccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transferAccount   Account?        @relation("TransferDestinationAccount", fields: [transferAccountId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId, transactionDate])
  @@index([accountId, transactionDate])
  @@index([categoryId])
  @@index([transferAccountId])
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  amount     Decimal  @db.Decimal(14, 2)
  month      Int
  year       Int
  notes      String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
}

model RecurringTransaction {
  id                String                     @id @default(uuid())
  userId            String
  accountId         String
  categoryId        String?
  transferAccountId String?
  type              TransactionType
  amount            Decimal                    @db.Decimal(14, 2)
  description       String
  notes             String?
  frequency         RecurrenceFrequency
  intervalCount     Int                        @default(1)
  dayOfMonth        Int?
  dayOfWeek         Int?
  startDate         DateTime
  endDate           DateTime?
  nextRunAt         DateTime
  lastRunAt         DateTime?
  status            RecurringTransactionStatus @default(ACTIVE)
  externalReference String?
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account                    @relation("RecurringPrimaryAccount", fields: [accountId], references: [id], onDelete: Cascade)
  category          Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transferAccount   Account?                   @relation("RecurringTransferAccount", fields: [transferAccountId], references: [id], onDelete: SetNull)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([userId, status, nextRunAt])
  @@index([accountId])
  @@index([categoryId])
  @@index([transferAccountId])
}
